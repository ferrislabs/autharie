  "query": "\n                SELECT c.id,\n                       c.region,\n                       c.data_plane_id,\n                       c.instance_deployment_id,\n                       c.status,\n                       c.capacity,\n                       (SELECT count(*) FROM deployments d\n                        WHERE d.cell_id = c.id AND d.cell_slot_held) AS \"realms!\",\n                       c.created_at\n                FROM cells c\n                WHERE c.id = $1\n                ",
